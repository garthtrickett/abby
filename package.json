{
  "name": "abby",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:text": "npm run build:voice-tests && node --test --test-concurrency=4 test/text/*.test.ts test/composition/*.test.ts test/admission/*.test.ts test/voice/*.test.ts test/cliniko/*.test.ts test/portability/*.test.ts test/contract/*.test.ts && node --test test/runner/ordered-node-e2e.test.ts",
    "test:settings-isolation": "node scripts/probe-setting-e2e-isolation.mjs",
    "test:node-order": "node --test test/runner/ordered-node-e2e.test.ts",
    "test:settings-isolation:postgres": "bash scripts/with-postgres.sh node scripts/probe-setting-e2e-isolation-postgres.mjs",
    "test:settings-isolation:browser": "node scripts/probe-setting-e2e-isolation-postgres.mjs --browser-only",
    "test:signed-voice:postgres": "bash scripts/with-postgres.sh bash scripts/probe-signed-voice-postgres.sh",
    "db:migrate": "node scripts/migrate.ts",
    "db:generate": "kanel --config .kanelrc.cjs",
    "phone-index:refresh": "node scripts/refresh-cliniko-phone-index.ts",
    "text:availability": "node scripts/ask-cliniko-availability.ts",
    "voice:local": "node dist/runtime/scripts/serve-cliniko-voice.js",
    "voice:ops": "node scripts/read-voice-operations.ts",
    "voice:ops:prune": "node scripts/prune-voice-operations.ts",
    "voice:ops:check": "node scripts/check-voice-operations.ts",
    "voice:ops:send": "node scripts/send-voice-operational-alerts.ts",
    "voice:ops:receive": "node dist/runtime/scripts/serve-voice-operational-alert-receiver.js",
    "voice:ops:inbox": "node dist/runtime/scripts/read-voice-operational-alert-inbox.js",
    "cliniko:review-rehearsal": "node scripts/rehearse-cliniko-review.ts",
    "cliniko:lifecycle-rehearsal": "node scripts/rehearse-cliniko-lifecycle.ts",
    "voice:ops:recalls": "node scripts/read-cliniko-recall-queue.ts",
    "voice:ops:monitor-queue": "node dist/runtime/scripts/monitor-cliniko-queue.js",
    "voice:ops:speech": "node scripts/read-speech-gate-status.ts",
    "voice:test-policy": "node dist/runtime/scripts/set-voice-test-automation.js",
    "voice:preflight": "node scripts/preflight-voice-public.ts",
    "voice:probe-tunnel": "node scripts/probe-voice-tunnel.mjs",
    "voice:probe-runner-public": "npm run build:voice-tests && bash scripts/with-postgres.sh node scripts/probe-public-voice-runner.mjs",
    "build:dashboard": "esbuild src/standalone/dashboard/main.ts --bundle --format=esm --platform=browser --outfile=dist/dashboard/app.js",
    "build:cliniko-admin": "esbuild src/standalone/dashboard/cliniko-admin-main.ts --bundle --format=esm --platform=browser --outfile=dist/dashboard/cliniko-admin.js",
    "admin:local": "npm run build:cliniko-admin && node scripts/serve-cliniko-admin.ts",
    "demo:dashboard": "npm run build:dashboard && node src/standalone/dashboard/demo.ts",
    "build:availability-console": "esbuild src/standalone/availability-console/main.ts --bundle --format=esm --platform=browser --outfile=dist/availability-console/app.js",
    "demo:availability-console": "npm run build:availability-console && node scripts/demo-cliniko-availability-console.ts",
    "test:browser": "npm run build:dashboard && npm run build:cliniko-admin && npm run build:availability-console && npm run build:sign-in && playwright test && node --test test/runner/ordered-browser-e2e.test.ts",
    "test:postgres": "npm run build:voice-tests && npm run build:cliniko-admin && npm run build:availability-console && node --test --test-concurrency=4 test/text/*.test.ts test/storage/*.test.ts test/composition/*.test.ts test/admission/*.test.ts test/voice/*.test.ts test/cliniko/*.test.ts test/portability/*.test.ts test/contract/*.test.ts && node --test test/runner/ordered-node-e2e.test.ts",
    "eval:model": "node scripts/evaluate-model.ts",
    "eval:availability-intent": "node scripts/evaluate-availability-intent.ts",
    "eval:clinical-intent": "node scripts/evaluate-clinical-intent.ts",
    "eval:transcription": "node scripts/evaluate-transcription.ts",
    "eval:file-transcription": "node scripts/evaluate-file-transcription.ts",
    "eval:speech-loop": "node scripts/evaluate-speech-loop.ts",
    "eval:speech-fallback": "node scripts/evaluate-first-chunk-fallback.ts",
    "eval:speech-gate": "node scripts/assess-speech-evaluation.ts",
    "probe:postgres": "bash scripts/with-postgres.sh bash scripts/probe-postgres.sh",
    "test": "npm run typecheck && npm run test:text",
    "test:browser-order": "npm run build:dashboard && npm run build:cliniko-admin && node --test test/runner/ordered-browser-e2e.test.ts",
    "build:sign-in": "esbuild src/standalone/dashboard/sign-in-main.ts --bundle --format=esm --platform=browser --outfile=dist/dashboard/sign-in.js",
    "eval:conversations": "node scripts/evaluate-clinic-conversations.ts",
    "build:runtime": "tsc --project tsconfig.runtime.json",
    "build:voice-tests": "tsc --project tsconfig.voice-test.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pg": "8.20.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "kanel": "3.16.1",
    "kanel-kysely": "0.7.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "kysely": "0.28.17",
    "lit-html": "^3.3.3",
    "pg": "8.21.0",
    "twilio": "^5.13.1",
    "ws": "^8.22.0"
  }
}
